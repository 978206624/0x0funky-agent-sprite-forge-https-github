# Dependencies
node_modules/

# Electron / Vite build output
app/out/
app/dist/
app/release/
app/.vite/

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# SQLite runtime db (user data)
*.db
*.db-shm
*.db-wal

# /tk multi-model review session scratch
.tk-meeting/

# work/ 实验草稿（手动出图脚本/产物/布局参考/内嵌参考仓库，大体积二进制，不入库）
# 注：早期已 commit 的 work/* 文件（fire-mage-cast-guide、reference-girl-*）仍受 git 跟踪；
# 本 blanket 仅忽略未跟踪的新草稿（如各 *-fourdir-* 实验目录），不影响已跟踪文件。
work/

# Generated sprite assets / experiment scratch (大体积二进制，不入库)
outputs/

# Claude per-task review 状态文件
.claude/.needs-review

# Claude 调度锁等运行时残留
.claude/scheduled_tasks.lock

# Python 字节码缓存
__pycache__/
*.pyc

# TS 增量编译缓存
*.tsbuildinfo
